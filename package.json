{
  "name": "bookmark-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-browser bookmark sync over storage you choose",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "cross-env BSYNC_RELEASE=1 wxt zip && cross-env BSYNC_RELEASE=1 wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "extension-id": "node scripts/extension-id.mjs",
    "make-key": "node scripts/make-key.mjs",
    "site": "node scripts/build-site.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "check": "tsc --noEmit && biome check && vitest run",
    "test:e2e": "cross-env BSYNC_E2E=1 wxt build && vitest run --config vitest.e2e.config.ts",
    "promo": "node promo/music.mjs && node promo/render.mjs",
    "promo:capture": "cross-env BSYNC_E2E=1 wxt build && node promo/capture.mjs"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.3",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@preact/preset-vite": "^2.10.6",
    "@tabler/icons": "^3.49.0",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "webdav-server": "^2.6.3",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "fractional-indexing": "^4.0.0",
    "preact": "^11.1.0"
  }
}
