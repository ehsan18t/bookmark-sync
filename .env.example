# Every value to set before going live. Change it here and rebuild; nothing else needs editing.
# Secrets go in .env.local, which git ignores (see .env.local.example).

# Shown in the browser, on the extension's pages and in the store listings.
WXT_APP_NAME=
WXT_APP_DESCRIPTION=

# Shown in Settings and as the manifest homepage. Empty values are hidden. Release builds need the first two.
WXT_HOMEPAGE_URL=
WXT_PRIVACY_URL=
WXT_SUPPORT_EMAIL=

# Website only (pnpm site). Empty links are hidden.
WXT_SOURCE_URL=
WXT_CHROME_STORE_URL=
WXT_EDGE_STORE_URL=
WXT_FIREFOX_STORE_URL=
WXT_PRIVACY_UPDATED=

# Firefox add-on ID: unique on addons.mozilla.org and never changed after the first release.
WXT_GECKO_ID=

# Public key that fixes the Chromium extension ID. pnpm make-key makes a new one; pnpm extension-id prints the ID.
WXT_CHROMIUM_KEY=

# Folder created on WebDAV servers. Every browser has to use the same one, so keep it after release.
WXT_SERVER_FOLDER=

# Google OAuth client IDs (not secret). See docs/google-setup.md.
WXT_GOOGLE_CLIENT_ID_CHROMIUM=
WXT_GOOGLE_CLIENT_ID_FIREFOX=

WXT_GOOGLE_CLIENT_SECRET_CHROMIUM=
WXT_GOOGLE_CLIENT_SECRET_FIREFOX=
